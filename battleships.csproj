<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <UseWindowsForms>true</UseWindowsForms>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
      <Compile Update="Battleship.WinForms\StartMenu.cs">
        <SubType>Form</SubType>
      </Compile>
      <Compile Update="Battleship.WinForms\GameSetup.cs">
        <SubType>Form</SubType>
      </Compile>
      <Compile Update="Battleship.WinForms\ShipPlacement.cs">
        <SubType>Form</SubType>
      </Compile>
      <Compile Update="Battleship.WinForms\GameBoard.cs">
        <SubType>Form</SubType>
      </Compile>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="ELTE.FI.SARuleSet" Version="3.2.1">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
    </ItemGroup>

</Project>